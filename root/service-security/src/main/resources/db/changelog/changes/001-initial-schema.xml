<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
            http://www.liquibase.org/xml/ns/dbchangelog
            https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-user-profile" author="superstore">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="USER_PROFILE"/>
            </not>
        </preConditions>

        <createTable tableName="USER_PROFILE">

            <column name="MOBILE" type="VARCHAR(10)">
                <constraints
                        primaryKey="true"
                        primaryKeyName="PK_USER_PROFILE"
                        nullable="false"/>
            </column>

            <column name="USERNAME" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="PASSWORD" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="ROLE" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="CREATE_USER" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="CREATE_TSTAMP" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="MODIFY_USER" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="MODIFY_TSTAMP" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="ACTIVE_FLAG" type="VARCHAR(1)"
                    defaultValue="Y">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addUniqueConstraint
                tableName="USER_PROFILE"
                columnNames="USERNAME"
                constraintName="UK_USER_PROFILE_USERNAME"/>

    </changeSet>


    <changeSet id="002-create-product" author="superstore">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="PRODUCT"/>
            </not>
        </preConditions>

        <createTable tableName="PRODUCT">

            <column name="COMPANY" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="SKU" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="NAME" type="VARCHAR(200)">
                <constraints nullable="false"/>
            </column>

            <column name="DEPARTMENT" type="VARCHAR(50)"/>
            <column name="CATEGORY" type="VARCHAR(50)"/>
            <column name="UPC" type="VARCHAR(50)"/>
            <column name="BARCODE" type="VARCHAR(50)"/>

            <column name="MRP" type="NUMERIC(10,2)"
                    defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="COST_PRICE" type="NUMERIC(10,2)"
                    defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="SELL_PRICE" type="NUMERIC(10,2)"
                    defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="STOCK" type="BIGINT"
                    defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="THRESHOLD" type="BIGINT"
                    defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="HSN_CODE" type="VARCHAR(8)"/>

            <column name="TAX_RATE" type="NUMERIC(5,2)"
                    defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="CESS_RATE" type="NUMERIC(5,2)"
                    defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>

            <column name="TAX_INCLUSIVE" type="BOOLEAN"
                    defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="TAX_EXEMPTED" type="BOOLEAN"
                    defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>

            <column name="PKD_DATE" type="DATE"/>
            <column name="EXP_DATE" type="DATE"/>

            <column name="CREATED_BY" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="CREATED_AT" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="UPDATED_BY" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="UPDATED_AT" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="ACTIVE" type="BOOLEAN"
                    defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addPrimaryKey
                tableName="PRODUCT"
                columnNames="COMPANY, SKU"
                constraintName="PK_PRODUCT"/>

        <createIndex
                tableName="PRODUCT"
                indexName="idx_product_sku">
            <column name="SKU"/>
        </createIndex>

        <createIndex
                tableName="PRODUCT"
                indexName="idx_product_name">
            <column name="NAME"/>
        </createIndex>

        <createIndex
                tableName="PRODUCT"
                indexName="idx_product_department">
            <column name="DEPARTMENT"/>
        </createIndex>

        <createIndex
                tableName="PRODUCT"
                indexName="idx_product_category">
            <column name="CATEGORY"/>
        </createIndex>

        <createIndex
                tableName="PRODUCT"
                indexName="idx_product_upc">
            <column name="UPC"/>
        </createIndex>

        <createIndex
                tableName="PRODUCT"
                indexName="idx_product_barcode">
            <column name="BARCODE"/>
        </createIndex>

        <createIndex
                tableName="PRODUCT"
                indexName="idx_product_hsncode">
            <column name="HSN_CODE"/>
        </createIndex>

    </changeSet>


    <changeSet id="003-create-order-header" author="superstore">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ORDER_HEADER"/>
            </not>
        </preConditions>

        <createTable tableName="ORDER_HEADER">

            <column name="ORD_NO" type="BIGINT">
                <constraints
                        primaryKey="true"
                        primaryKeyName="PK_ORDER_HEADER"
                        nullable="false"/>
            </column>

            <column name="MOBILE" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="CREATE_USER" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="CREATE_TSTAMP" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="MODIFY_USER" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="MODIFY_TSTAMP" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="ACTIVE_FLAG" type="VARCHAR(1)"
                    defaultValue="Y">
                <constraints nullable="false"/>
            </column>

        </createTable>

    </changeSet>


    <changeSet id="004-create-order-detail" author="superstore">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="ORDER_DETAIL"/>
            </not>
        </preConditions>

        <createTable tableName="ORDER_DETAIL">

            <column name="ORD_NO" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="LINE_NO" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="COMPANY" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="SKU" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="NAME" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="QTY" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="CREATE_USER" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="CREATE_TSTAMP" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="MODIFY_USER" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="MODIFY_TSTAMP" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="ACTIVE_FLAG" type="VARCHAR(1)"
                    defaultValue="Y">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <addPrimaryKey
                tableName="ORDER_DETAIL"
                columnNames="ORD_NO, LINE_NO"
                constraintName="PK_ORDER_DETAIL"/>

    </changeSet>

    <changeSet id="005-create-vector-schema" author="superstore">
        <sql dbms="postgresql">
            CREATE EXTENSION IF NOT EXISTS vector;
        </sql>

        <sql dbms="postgresql">
            CREATE SCHEMA IF NOT EXISTS superstore;
        </sql>
    </changeSet>

    <changeSet id="006-create-vector-store" author="superstore">
        <sql dbms="postgresql" splitStatements="false">
            <![CDATA[
            CREATE TABLE IF NOT EXISTS superstore.vector_store (
                id VARCHAR(255) PRIMARY KEY,
                content TEXT NOT NULL,
                metadata JSONB,
                embedding vector(768) NOT NULL
            );

            CREATE INDEX IF NOT EXISTS vector_store_embedding_idx
            ON superstore.vector_store
            USING hnsw (embedding vector_cosine_ops);
            ]]>
        </sql>
    </changeSet>

</databaseChangeLog>